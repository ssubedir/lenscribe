{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lenscribe",
  "version": "0.1.4",
  "identifier": "com.ssubedir.lenscribe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Lenscribe Settings",
        "width": 1000,
        "height": 760,
        "minWidth": 640,
        "minHeight": 560,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#fafbf9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/lenscribe-v2/32x32.png",
      "icons/lenscribe-v2/128x128.png",
      "icons/lenscribe-v2/128x128@2x.png",
      "icons/lenscribe-v2/icon.icns",
      "icons/lenscribe-v2/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQjJENDRCMTkyMTgwREUKUldUZWdDRVpTOVN5blM1TlF2K2pVb2JpZjRmbDloTHROT0tjOXAwV2tEQUFHUDQxamg5bnAreUEK",
      "endpoints": ["https://github.com/ssubedir/lenscribe/releases/latest/download/latest.json"]
    }
  }
}
