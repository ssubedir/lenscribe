{
  "name": "lenscribe",
  "version": "0.1.5",
  "description": "",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run types:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "format": "prettier --write src tests scripts .github package.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts .github package.json .prettierrc.json",
    "release:version": "bun scripts/release-version.ts",
    "types:generate": "cargo run --manifest-path src-tauri/Cargo.toml -p lenscribe-core --features bindings --bin export-bindings",
    "types:check": "cargo run --manifest-path src-tauri/Cargo.toml -p lenscribe-core --features bindings --bin export-bindings -- --check",
    "test": "bun test tests"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
